{
  "name": "evshare-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:contracts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --project=chromium --update-snapshots",
    "test:compatibility": "playwright test tests/e2e/compatibility.spec.ts",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:api": "playwright test tests/e2e/api.spec.ts --project=chromium",
    "test:security": "playwright test tests/e2e/security.spec.ts --project=chromium",
    "test:dependencies": "pnpm audit --audit-level high",
    "test:performance": "node tests/performance/dashboard-load.mjs",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "test:phone": "node --test tests/tenant-phone.test.mjs",
    "test:feature-flags": "node --test tests/feature-flags.test.mjs",
    "test:users": "node --test tests/user-account-actions.test.mjs",
    "test:contracts": "node --test tests/contracts.test.mjs",
    "test:operations": "node --test tests/operational-contracts.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@vis.gl/react-google-maps": "^1.9.0",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "1.13.11",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-phone-number-input": "^3.4.18",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 88",
    "safari >= 14",
    "ios_saf >= 14"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
